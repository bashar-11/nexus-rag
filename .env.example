# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in the values.
# `.env` is git-ignored and must never be committed.
#
# Every value below can also be set in Streamlit Cloud under
# Settings -> Secrets. Resolution order is: `.env`, then Streamlit secrets.
# ---------------------------------------------------------------------------

# Required. API key from https://console.groq.com/keys
# Used to generate the final answer with Llama 3.3 70B.
GROQ_API_KEY=your_groq_api_key_here

# Required. Qdrant cluster credentials from https://cloud.qdrant.io/
# Used for dense semantic search. A local Qdrant instance also works.
QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional. Defaults to "nexus_rag_docs" when unset.
COLLECTION_NAME=nexus_rag_docs